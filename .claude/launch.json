{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "iuris-backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "iuris-preview",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "port": 8010,
      "url": "http://127.0.0.1:8010"
    },
    {
      "name": "desemppa-red",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8010"
      ],
      "port": 8010,
      "url": "http://127.0.0.1:8010",
      "env": {
        "IURIS_ESCUCHA_RED": "1"
      }
    },
    {
      "name": "desemppa-demo-simulada",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["tests/e2e/fake_server.py", "8030"],
      "port": 8030,
      "url": "http://127.0.0.1:8030",
      "env": {
        "IURIS_DATA_DIR": "data/local/demo_simulada",
        "IURIS_WEB_DIST": "web/dist",
        "GEMINI_API_KEY": ""
      }
    },
    {
      "name": "desemppa-respaldo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8020"
      ],
      "port": 8020,
      "url": "http://127.0.0.1:8020"
    }
  ]
}
