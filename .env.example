# Copia este archivo a .env y rellena los valores. .env está excluido de git.

# Clave de la Gemini API (Google AI Studio). Free tier: NO enviar datos personales sin seudonimizar (dossier §1.1.4).
GEMINI_API_KEY=

# Rutas de datos locales (por defecto bajo %LOCALAPPDATA%\iuris)
IURIS_DATA_DIR=%LOCALAPPDATA%\iuris
IURIS_SQLITE_PATH=%LOCALAPPDATA%\iuris\local_cache.db
IURIS_LANCEDB_DIR=%LOCALAPPDATA%\iuris\lancedb_store

# CLI de Claude Code (ruta absoluta; vacío = shutil.which("claude"))
IURIS_CLAUDE_EXE=
# Directorio vacío como cwd de `claude -p` (evita cargar CLAUDE.md/herramientas del proyecto)
IURIS_CLAUDE_SANDBOX_DIR=%LOCALAPPDATA%\iuris\claude_sandbox

# Servidor local: solo loopback (dossier §2.5)
IURIS_HOST=127.0.0.1
IURIS_PORT=8000

# DEBUG | INFO | WARNING | ERROR
IURIS_LOG_LEVEL=INFO
