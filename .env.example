# Copia este archivo a .env y rellena lo que necesites. .env está excluido de git.

# Clave de la Gemini API (Google AI Studio, plan gratuito). Su cuota diaria es baja: la app la usa para tareas de
# volumen y salta a otros modelos cuando se agota. El plan gratuito puede usar lo que recibe para mejorar productos de
# Google: la app seudonimiza el texto y no envía adjuntos sin tu consentimiento.
GEMINI_API_KEY=

# Carpeta de datos (consultas, caché, log, token). Por defecto: data/local dentro del proyecto.
# NO la pongas en %LOCALAPPDATA%: Windows la redirige para algunos programas y acabarías con dos bases de datos.
# IURIS_DATA_DIR=C:\ruta\a\mis\datos\iuris

# CLI de Claude Code (ruta absoluta). Vacío = se busca "claude" en el PATH.
IURIS_CLAUDE_EXE=

# Servidor local: solo loopback (no lo expongas a la red).
IURIS_HOST=127.0.0.1
IURIS_PORT=8000

# DEBUG | INFO | WARNING | ERROR
IURIS_LOG_LEVEL=INFO
